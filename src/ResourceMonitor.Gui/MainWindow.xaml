<Window x:Class="ResourceMonitor.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ResourceMonitor.Gui.Views"
        mc:Ignorable="d"
        Icon="Assets/app.ico"
        Title="ResourceMonitor" Height="700" Width="1000">
    <!-- Só o menu e o lugar das telas. Cada tela é um UserControl em Views/; estilos e
         conversores comuns ficam em Themes/Styles.xaml (mesclado no App.xaml). -->
    <DockPanel>
        <Menu DockPanel.Dock="Top" x:Name="MainMenu" BorderThickness="0,0,0,2" BorderBrush="#14171D">
            <MenuItem x:Name="MenuHome" Header="Home" Tag="Active" Style="{StaticResource MainMenuItemStyle}" Click="OnMenuHomeClick" />
            <MenuItem x:Name="MenuConfiguracoes" Header="Configurações" Style="{StaticResource MainMenuItemStyle}" Click="OnMenuConfiguracoesClick" />
            <MenuItem x:Name="MenuDados" Header="Templates" Style="{StaticResource MainMenuItemStyle}" Click="OnMenuDadosClick" />
            <MenuItem x:Name="MenuGraficos" Header="Gráficos" Style="{StaticResource MainMenuItemStyle}">
                <MenuItem x:Name="MenuGraficosDadosCorrentes" Header="Dados Correntes" Click="OnMenuGraficosDadosCorrentesClick" />
                <MenuItem x:Name="MenuGraficosTendencia" Header="Tendência" Click="OnMenuGraficosTendenciaClick" />
                <MenuItem x:Name="MenuGraficosEventos" Header="Eventos de Picos" Click="OnMenuGraficosEventosClick" />
            </MenuItem>
            <MenuItem x:Name="MenuRelatorios" Header="Relatórios" Style="{StaticResource MainMenuItemStyle}" Click="OnMenuRelatoriosClick" />
            <MenuItem x:Name="MenuAjuda" Header="Ajuda" Style="{StaticResource MainMenuItemStyle}" Click="OnMenuAjudaClick" />
        </Menu>

        <Grid x:Name="ContentHost">
            <views:HomeView x:Name="HomeTabRoot" Visibility="Collapsed" />
            <views:SettingsView x:Name="MonitoringTabRoot" Visibility="Collapsed" />
            <views:TemplatesView x:Name="TemplatesTabRoot" Visibility="Collapsed" />
            <views:ChartLiveView x:Name="ChartLiveTabRoot" Visibility="Collapsed" />
            <views:ChartTrendView x:Name="ChartTrendTabRoot" Visibility="Collapsed" />
            <views:ChartEventsView x:Name="ChartEventosTabRoot" Visibility="Collapsed" />
            <views:ReportView x:Name="ReportTabRoot" Visibility="Collapsed" />
            <views:HelpView x:Name="HelpTabRoot" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
