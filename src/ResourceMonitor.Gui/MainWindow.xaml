<Window x:Class="ResourceMonitor.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ResourceMonitor.Gui"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:conv="clr-namespace:ResourceMonitor.Gui.Converters"
        mc:Ignorable="d"
        Icon="Assets/app.ico"
        Title="ResourceMonitor" Height="700" Width="1000">
    <Window.Resources>
        <conv:MetricDisplayConverter x:Key="MetricDisplayConverter" />
        <conv:LocalDateTimeConverter x:Key="LocalDateTimeConverter" />
        <conv:DurationMinutesDisplayConverter x:Key="DurationMinutesDisplayConverter" />
        <conv:DiskUsageFromFreeConverter x:Key="DiskUsageFromFreeConverter" />
        <conv:GroupedProcessNameConverter x:Key="GroupedProcessNameConverter" />
        <conv:BoolToActiveLabelConverter x:Key="BoolToActiveLabelConverter" />
        <conv:BoolToActiveBackgroundConverter x:Key="BoolToActiveBackgroundConverter" />
        <conv:BoolToActiveForegroundConverter x:Key="BoolToActiveForegroundConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ActivePillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Background" Value="{Binding Converter={StaticResource BoolToActiveBackgroundConverter}}" />
        </Style>

        <!-- Item ativo: sublinhado + negrito, sem cor de métrica (CPU/RAM/I/O ficam reservadas pros gráficos) -->
        <Style x:Key="MainMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderBrush" Value="#14171D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sem x:Key: vira o estilo implícito de TODO CheckBox da janela (Monitoramento,
             Limpeza, filtros de Gráficos/Relatórios) — troca a caixinha quadrada padrão do
             Windows por um quadrado arredondado + check desenhado, sem precisar marcar cada
             CheckBox individualmente. -->
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="7,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="Hand">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    BorderBrush="#C3C8D1" BorderThickness="1.5" Background="White"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M 3,8.5 L 6.7,12 L 13,4" Stretch="Uniform" Margin="2.5"
                                      Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#14171D" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#14171D" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#14171D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" x:Name="MainMenu" BorderThickness="0,0,0,2" BorderBrush="#14171D">
            <MenuItem x:Name="MenuHome" Header="Home" Tag="Active" Style="{StaticResource MainMenuItemStyle}" Click="OnMenuHomeClick" />
            <MenuItem x:Name="MenuConfiguracoes" Header="Configurações" Style="{StaticResource MainMenuItemStyle}" Click="OnMenuConfiguracoesClick" />
            <MenuItem x:Name="MenuDados" Header="Templates" Style="{StaticResource MainMenuItemStyle}" Click="OnMenuDadosClick" />
            <MenuItem x:Name="MenuGraficos" Header="Gráficos" Style="{StaticResource MainMenuItemStyle}">
                <MenuItem x:Name="MenuGraficosDadosCorrentes" Header="Dados Correntes" Click="OnMenuGraficosDadosCorrentesClick" />
                <MenuItem x:Name="MenuGraficosTendencia" Header="Tendência" Click="OnMenuGraficosTendenciaClick" />
                <MenuItem x:Name="MenuGraficosEventos" Header="Eventos de Picos" Click="OnMenuGraficosEventosClick" />
            </MenuItem>
            <MenuItem x:Name="MenuRelatorios" Header="Relatórios" Style="{StaticResource MainMenuItemStyle}" Click="OnMenuRelatoriosClick" />
            <MenuItem x:Name="MenuAjuda" Header="Ajuda" Style="{StaticResource MainMenuItemStyle}" Click="OnMenuAjudaClick" />
        </Menu>

        <Grid x:Name="ContentHost">

            <ScrollViewer x:Name="HomeTabRoot" Margin="16" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                            BorderBrush="#F0B429" BorderThickness="1" CornerRadius="3" Background="#FFFBEB"
                            Padding="12,10" Margin="0,0,0,16">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding UpdateAvailableMessage, Mode=OneWay}" />
                            <Hyperlink NavigateUri="{Binding UpdateReleaseUrl, Mode=OneWay}" RequestNavigate="OnCreditHyperlinkRequestNavigate">Ver no GitHub</Hyperlink>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="Visão geral" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Hardware.MachineName}" Foreground="Gray" FontSize="12" Margin="0,0,0,16" />

                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <Border BorderBrush="#E2E5EA" BorderThickness="1" CornerRadius="3" Background="#FAFBFC" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="RESUMO DO COMPUTADOR" FontSize="11" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome" Foreground="Gray" Margin="0,0,14,7" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hardware.MachineName}" FontWeight="Bold" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Sistema" Foreground="Gray" Margin="0,0,14,7" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hardware.OperatingSystem}" FontWeight="Bold" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Processador" Foreground="Gray" Margin="0,0,14,7" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Hardware.ProcessorName}" FontWeight="Bold" Margin="0,0,0,7" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Memória RAM" Foreground="Gray" Margin="0,0,14,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Hardware.RamTotalGb, StringFormat='{}{0:N1} GB'}" FontWeight="Bold" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Hardware.Disks}" Margin="0,7,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DriveName}" Foreground="Gray" Margin="0,0,14,0" />
                                                <TextBlock Grid.Column="1" FontWeight="Bold">
                                                    <Run Text="{Binding TotalGb, StringFormat='{}{0:N1} GB total', Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding FreeGb, StringFormat='{}{0:N1} GB livres', Mode=OneWay}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#E2E5EA" BorderThickness="1" CornerRadius="3" Background="#FAFBFC" Padding="16" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="RESUMO DE CONFIGURAÇÕES" FontSize="11" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,12" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" DataContext="{Binding MonitoringActive}">
                                    <TextBlock Text="Monitoramento" Width="200" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource ActivePillStyle}">
                                        <TextBlock Text="{Binding Converter={StaticResource BoolToActiveLabelConverter}}"
                                                   Foreground="{Binding Converter={StaticResource BoolToActiveForegroundConverter}}"
                                                   FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" DataContext="{Binding StartWithWindowsActive}">
                                    <TextBlock Text="Iniciar com o Windows" Width="200" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource ActivePillStyle}">
                                        <TextBlock Text="{Binding Converter={StaticResource BoolToActiveLabelConverter}}"
                                                   Foreground="{Binding Converter={StaticResource BoolToActiveForegroundConverter}}"
                                                   FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" DataContext="{Binding ExcludedProcessesActive}">
                                    <TextBlock Text="Processos excluídos" Width="200" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource ActivePillStyle}">
                                        <TextBlock Text="{Binding Converter={StaticResource BoolToActiveLabelConverter}}"
                                                   Foreground="{Binding Converter={StaticResource BoolToActiveForegroundConverter}}"
                                                   FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" DataContext="{Binding CustomDiskThresholdsActive}">
                                    <TextBlock Text="Limites de disco personalizados" Width="200" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource ActivePillStyle}">
                                        <TextBlock Text="{Binding Converter={StaticResource BoolToActiveLabelConverter}}"
                                                   Foreground="{Binding Converter={StaticResource BoolToActiveForegroundConverter}}"
                                                   FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Limites CPU / RAM / I/O" Width="200" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ThresholdsSummary}" Foreground="Gray" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Intervalo de amostragem" Width="200" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SampleIntervalSummary}" Foreground="Gray" VerticalAlignment="Center" />
                                </StackPanel>

                                <Border BorderBrush="#E2E5EA" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0" HorizontalAlignment="Stretch">
                                    <TextBlock HorizontalAlignment="Right">
                                        <Hyperlink Click="OnMenuConfiguracoesClick">Editar configurações →</Hyperlink>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border BorderBrush="#E2E5EA" BorderThickness="1" CornerRadius="3" Background="#FAFBFC" Padding="16">
                        <StackPanel>
                            <TextBlock Text="MONITOR DE RECURSOS EM TEMPO REAL" FontSize="11" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>

                                <wv2:WebView2 Grid.Column="0" x:Name="HomeLiveChartWebView" Height="220" />

                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Top 5 processos" FontWeight="Bold" Margin="0,0,0,6" />
                                    <TabControl>
                                        <TabItem Header="CPU">
                                            <ItemsControl ItemsSource="{Binding TopByCpu}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,0,0,2" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Converter={StaticResource GroupedProcessNameConverter}, Mode=OneWay}" />
                                                            <Run Text=" — " />
                                                            <Run Text="{Binding CpuPercent, StringFormat='{}{0:N1}%', Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </TabItem>
                                        <TabItem Header="RAM">
                                            <ItemsControl ItemsSource="{Binding TopByRam}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,0,0,2" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Converter={StaticResource GroupedProcessNameConverter}, Mode=OneWay}" />
                                                            <Run Text=" — " />
                                                            <Run Text="{Binding RamMb, StringFormat='{}{0:N0} MB', Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </TabItem>
                                        <TabItem Header="Disco I/O">
                                            <ItemsControl ItemsSource="{Binding TopByIo}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,0,0,2" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Converter={StaticResource GroupedProcessNameConverter}, Mode=OneWay}" />
                                                            <Run Text=" — " />
                                                            <Run Text="{Binding IoKbPerSec, StringFormat='{}{0:N0} KB/s', Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </TabItem>
                                    </TabControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock HorizontalAlignment="Right" Margin="0,16,0,0" Foreground="Gray" FontSize="11">
                        <Hyperlink NavigateUri="https://icons8.com" RequestNavigate="OnCreditHyperlinkRequestNavigate">Ícone por Icons8</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <!-- Configurações: sem botão Salvar — grava sozinho ao iniciar, trocar de tela,
                 minimizar, fechar e sair (ver MonitoringViewModel.SaveIfChanged). -->
            <ScrollViewer x:Name="MonitoringTabRoot" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ScrollViewer.Resources>
                    <Style x:Key="SectionBorder" TargetType="Border">
                        <Setter Property="BorderBrush" Value="#E2E5EA" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="3" />
                        <Setter Property="Background" Value="#FAFBFC" />
                        <Setter Property="Padding" Value="16,12" />
                        <Setter Property="Margin" Value="0,0,0,12" />
                    </Style>
                    <Style x:Key="SectionHeader" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Foreground" Value="Gray" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                    <Style x:Key="FieldLabel" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#4B5563" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                    </Style>
                    <Style x:Key="FieldCell" TargetType="StackPanel">
                        <Setter Property="Margin" Value="0,0,16,0" />
                    </Style>
                </ScrollViewer.Resources>

                <StackPanel Margin="16">
                    <!-- Estado e controles -->
                    <Border Style="{StaticResource SectionBorder}">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Left" CornerRadius="9" Padding="10,3" VerticalAlignment="Center" Margin="0,0,12,0"
                                        Background="{Binding IsRunning, Converter={StaticResource BoolToActiveBackgroundConverter}}">
                                    <TextBlock Text="{Binding StatePillText}" FontWeight="Bold"
                                               Foreground="{Binding IsRunning, Converter={StaticResource BoolToActiveForegroundConverter}}" />
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Iniciar" Command="{Binding StartCommand}" Padding="12,4" Margin="0,0,8,0" />
                                    <Button Content="Parar" Command="{Binding StopCommand}" Padding="12,4" Margin="0,0,16,0" />
                                    <CheckBox Content="Iniciar com o Windows" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LastSampleText}" Foreground="#4B5563" />
                                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding EditHintText}" Foreground="Gray" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel IsEnabled="{Binding CanEditSettings}">
                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="LIMITES DE ALERTA" Style="{StaticResource SectionHeader}" />
                                <UniformGrid Columns="3">
                                    <StackPanel Style="{StaticResource FieldCell}">
                                        <TextBlock Text="CPU (%)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding CpuPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldCell}">
                                        <TextBlock Text="RAM (%)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding RamPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldCell}">
                                        <TextBlock Text="I/O de disco (%)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding DiskIoPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="AMOSTRAGEM E DISPARO" Style="{StaticResource SectionHeader}" />
                                <UniformGrid Columns="3">
                                    <StackPanel Style="{StaticResource FieldCell}">
                                        <TextBlock Text="Intervalo de amostragem (s)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SampleIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldCell}">
                                        <TextBlock Text="Amostras seguidas p/ disparar" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding ConsecutiveBreachesToAlert, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldCell}">
                                        <TextBlock Text="Amostras seguidas p/ recuperar" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding ConsecutiveRecoveriesToClear, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="JANELA DE PICO" Style="{StaticResource SectionHeader}" />
                                <UniformGrid Columns="3">
                                    <StackPanel Style="{StaticResource FieldCell}">
                                        <TextBlock Text="Segundos antes do pico" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding PreEventSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldCell}">
                                        <TextBlock Text="Segundos depois do pico" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding PostEventSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource FieldCell}">
                                        <TextBlock Text="Top N processos no snapshot" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding TopProcessCount, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="PROCESSOS QUE NÃO DISPARAM OS LIMITES" Style="{StaticResource SectionHeader}" />
                                <ItemsControl ItemsSource="{Binding ExcludedProcesses}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#C3C8D1" BorderThickness="1" CornerRadius="3" Background="White" Margin="0,0,8,8" Padding="8,2,2,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <Button Content="✕" ToolTip="Remover" Padding="5,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Command="{Binding DataContext.RemoveExcludedProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding NewExcludedProcessPattern, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" />
                                    <Button Content="Adicionar" Command="{Binding AddExcludedProcessCommand}" Padding="12,2" />
                                    <TextBlock Text="aceita * como coringa, ex: notepad*" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="ESPAÇO LIVRE MÍNIMO POR DISCO (%)" Style="{StaticResource SectionHeader}" />
                                <ItemsControl ItemsSource="{Binding DiskThresholds}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#C3C8D1" BorderThickness="1" CornerRadius="3" Background="White" Margin="0,0,8,0" Padding="8,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DriveName}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBox Text="{Binding MinFreePercent, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorder}">
                            <StackPanel>
                                <TextBlock Text="HISTÓRICO" Style="{StaticResource SectionHeader}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Manter base de picos por (dias)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding PeakRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                    <TextBlock Text="0 = guardar para sempre; a tendência diária é sempre mantida" Foreground="Gray" FontSize="11"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Left" Content="Restaurar padrões" Command="{Binding RestoreDefaultsCommand}" Padding="12,4" />
                        <TextBlock Text="{Binding SavedNoticeText}" Foreground="Gray" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Realocado da antiga aba Dados: não é uma consulta, é ação administrativa,
                         então fica em Configurações em vez da tela de Templates. Borda avermelhada:
                         apaga dados. -->
                    <Border Style="{StaticResource SectionBorder}" BorderBrush="#F3C4C4">
                        <StackPanel>
                            <TextBlock Text="LIMPEZA DE DADOS" Style="{StaticResource SectionHeader}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Limpar selecionados" Command="{Binding ClearSelectedCommand}" Padding="12,4" />
                                <WrapPanel VerticalAlignment="Center">
                                    <CheckBox Content="Tendência diária" IsChecked="{Binding ClearTrendSelected}"
                                              VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <CheckBox Content="Base de picos" IsChecked="{Binding ClearPeaksSelected}"
                                              VerticalAlignment="Center" Margin="0,0,16,0"
                                              ToolTip="Eventos, amostras da janela de pico e snapshots de processos" />
                                </WrapPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock HorizontalAlignment="Right" Margin="0,4,0,0" Foreground="Gray" FontSize="11">
                        <Hyperlink NavigateUri="https://icons8.com" RequestNavigate="OnCreditHyperlinkRequestNavigate">Ícone por Icons8</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="TemplatesTabRoot" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!-- Altura ajustada em code-behind (OnTemplatesEditorVisibilityChanged), não
                         por binding — RowDefinition não herda DataContext de forma confiável no
                         WPF, então {Binding} aqui simplesmente não reagia à troca do toggle. -->
                    <RowDefinition x:Name="EditorRow" Height="0" />
                    <RowDefinition x:Name="EditorSplitterRow" Height="0" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" MinHeight="80" />
                </Grid.RowDefinitions>

                <!-- Seletor de template existente — some quando IsCreatingNew (ver painel abaixo) -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,8" Visibility="{Binding IsCreatingNew, Converter={StaticResource InverseBoolToVis}}">
                    <Label Content="Template:" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                              DisplayMemberPath="Name" Width="220" Margin="4,0,16,0" VerticalAlignment="Center" />
                    <Button Content="Novo Template" Command="{Binding IniciarNovoTemplateCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Salvar alterações" Command="{Binding SalvarAlteracoesCommand}" Padding="12,4" Margin="0,0,8,0"
                            ToolTip="Salva o SQL editado de volta nesse template — só disponível pra templates criados por você" />
                    <Button Content="Excluir" Command="{Binding ExcluirTemplateCommand}" Padding="12,4"
                            ToolTip="Só disponível pra templates criados por você — os 3 padrão não podem ser excluídos" />
                </WrapPanel>

                <!-- Criação de novo template — só aparece com IsCreatingNew -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,8" Visibility="{Binding IsCreatingNew, Converter={StaticResource BoolToVis}}">
                    <Label Content="Nome:" VerticalAlignment="Center" />
                    <TextBox Text="{Binding NewTemplateName, UpdateSourceTrigger=PropertyChanged}"
                              Width="220" Margin="4,0,16,0" VerticalAlignment="Center" />
                    <Button Content="Salvar" Command="{Binding SalvarNovoTemplateCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Cancelar" Command="{Binding CancelarNovoTemplateCommand}" Padding="12,4" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding NewTemplateError}" Foreground="Red" VerticalAlignment="Center" />
                </WrapPanel>

                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                    <Label Content="De:" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding PeriodFrom}" VerticalAlignment="Center" Margin="4,0,16,0" />
                    <Label Content="Até:" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding PeriodTo}" VerticalAlignment="Center" Margin="4,0,16,0"
                                ToolTip="$from/$to ficam disponíveis pro SQL do template, formatados em UTC ISO-8601" />
                    <Button Content="Executar" Command="{Binding ExecutarCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Exportar CSV" Command="{Binding ExportarCsvCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Editor" Command="{Binding AlternarEditorCommand}" Padding="12,4"
                            ToolTip="Mostra/esconde o editor SQL" />
                </WrapPanel>

                <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVis}}">
                    <!-- Tab insere 4 espaços em vez de tirar o foco (ver OnSqlEditorPreviewKeyDown). -->
                    <TextBox x:Name="SqlEditorTextBox"
                             Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Padding="6"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Cascadia Code, Consolas, Courier New" FontSize="13"
                             SpellCheck.IsEnabled="False" PreviewKeyDown="OnSqlEditorPreviewKeyDown" />
                </Border>

                <!-- Arrasta pra redimensionar o editor SQL em relação à grade de resultado
                     abaixo (linha 2 acima / linha 5 abaixo, ver ResizeBehavior). -->
                <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="#DDDDDD" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                              Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVis}}" />

                <TextBlock Grid.Row="4" Text="{Binding StatusText}" Margin="0,8,0,8" />

                <!-- Colunas construídas em code-behind (ver OnTemplateResultReady) — o
                     resultado de uma consulta arbitrária não tem colunas fixas em tempo de
                     compilação. Duplo-clique numa linha abre o popup de pico quando o
                     resultado tem StartEventId+Metric (ver OnTemplateResultsGridDoubleClick). -->
                <DataGrid Grid.Row="5" x:Name="TemplateResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          MouseDoubleClick="OnTemplateResultsGridDoubleClick" />
            </Grid>

            <Grid x:Name="ChartLiveTabRoot" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding LiveStatusText, StringFormat='Dados correntes (ao vivo): {0}'}" Margin="0,0,0,8" FontWeight="Bold" />
                <wv2:WebView2 Grid.Row="1" x:Name="LiveChartWebView" />
            </Grid>

            <Grid x:Name="ChartTrendTabRoot" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding TrendStatusText}" Margin="0,0,0,8" FontWeight="Bold" />
                <wv2:WebView2 Grid.Row="1" x:Name="TrendChartWebView" />
            </Grid>

            <Grid x:Name="ChartEventosTabRoot" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <Label Content="De:" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding PeriodFrom}" VerticalAlignment="Center" Margin="4,0,16,0" />
                    <Label Content="Até:" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding PeriodTo}" VerticalAlignment="Center" Margin="4,0,16,0" />
                    <CheckBox Content="CPU" IsChecked="{Binding IncludeCpu}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Content="RAM" IsChecked="{Binding IncludeRam}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Content="Disco I/O" IsChecked="{Binding IncludeDiscoIo}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="Carregar" Command="{Binding CarregarEventosDePicosCommand}" Padding="12,4" VerticalAlignment="Center" />
                </WrapPanel>

                <TextBlock Grid.Row="1" Text="{Binding EventosStatusText}" Margin="0,0,0,8" />

                <!-- Clicar num marcador (bolinha) abre EpisodeDetailWindow com os processos
                     daquele pico — ver chart.html (postMessage) + OnEventsChartWebMessageReceived. -->
                <wv2:WebView2 Grid.Row="2" x:Name="EventsChartWebView" />
            </Grid>

            <Grid x:Name="ReportTabRoot" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#E2E5EA" BorderThickness="1" CornerRadius="3" Background="#FAFBFC"
                        Padding="12,10" Margin="0,4,0,12">
                    <WrapPanel>
                        <Label Content="De:" VerticalAlignment="Center" Margin="0,0,4,6" />
                        <DatePicker SelectedDate="{Binding PeriodFrom}" VerticalAlignment="Center" Margin="0,0,22,6" />
                        <Label Content="Até:" VerticalAlignment="Center" Margin="0,0,4,6" />
                        <DatePicker SelectedDate="{Binding PeriodTo}" VerticalAlignment="Center" Margin="0,0,22,6" />
                        <CheckBox Content="CPU" IsChecked="{Binding IncludeCpu}" VerticalAlignment="Center" Margin="0,0,16,6" />
                        <CheckBox Content="RAM" IsChecked="{Binding IncludeRam}" VerticalAlignment="Center" Margin="0,0,16,6" />
                        <CheckBox Content="Disco I/O" IsChecked="{Binding IncludeDiscoIo}" VerticalAlignment="Center" Margin="0,0,22,6" />
                        <CheckBox Content="Ofensores" IsChecked="{Binding IncludeOffenders}" VerticalAlignment="Center" Margin="0,0,16,6" />
                        <CheckBox Content="Padrão de horário" IsChecked="{Binding IncludeHourlyPattern}" VerticalAlignment="Center" Margin="0,0,16,6" />
                        <CheckBox Content="Projeção de disco" IsChecked="{Binding IncludeDiskProjection}" VerticalAlignment="Center" Margin="0,0,22,6" />
                        <CheckBox Content="Incluir todos os eventos" IsChecked="{Binding IncludeAllEvents}" VerticalAlignment="Center" Margin="0,0,0,6"
                                  ToolTip="Se desmarcado, o relatório mostra só o resumo e a quebra por métrica, sem a tabela completa de eventos" />
                    </WrapPanel>
                </Border>

                <TextBlock Grid.Row="1" Text="{Binding StatusText}" Margin="0,0,0,8" />

                <wv2:WebView2 Grid.Row="2" x:Name="ReportWebView" />
            </Grid>

            <wv2:WebView2 x:Name="HelpWebView" Margin="16" Visibility="Collapsed" />

        </Grid>
    </DockPanel>
</Window>
