<Window x:Class="ResourceMonitor.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ResourceMonitor.Gui"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:conv="clr-namespace:ResourceMonitor.Gui.Converters"
        mc:Ignorable="d"
        Icon="Assets/app.ico"
        Title="ResourceMonitor" Height="700" Width="1000">
    <Window.Resources>
        <conv:MetricDisplayConverter x:Key="MetricDisplayConverter" />
        <conv:LocalDateTimeConverter x:Key="LocalDateTimeConverter" />
        <conv:DurationMinutesDisplayConverter x:Key="DurationMinutesDisplayConverter" />
        <conv:DiskUsageFromFreeConverter x:Key="DiskUsageFromFreeConverter" />
        <conv:OffenderKindDisplayConverter x:Key="OffenderKindDisplayConverter" />
        <conv:GroupedProcessNameConverter x:Key="GroupedProcessNameConverter" />
        <conv:BoolToActiveLabelConverter x:Key="BoolToActiveLabelConverter" />
        <conv:BoolToActiveBackgroundConverter x:Key="BoolToActiveBackgroundConverter" />
        <conv:BoolToActiveForegroundConverter x:Key="BoolToActiveForegroundConverter" />

        <Style x:Key="ActivePillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Background" Value="{Binding Converter={StaticResource BoolToActiveBackgroundConverter}}" />
        </Style>

        <!-- Item ativo: sublinhado + negrito, sem cor de métrica (CPU/RAM/I/O ficam reservadas pros gráficos) -->
        <Style x:Key="MainMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="BorderBrush" Value="#14171D" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" x:Name="MainMenu" BorderThickness="0,0,0,2" BorderBrush="#14171D">
            <MenuItem x:Name="MenuHome" Header="Home" Tag="Active" Style="{StaticResource MainMenuItemStyle}" Click="OnMenuHomeClick" />
            <MenuItem x:Name="MenuConfiguracoes" Header="Configurações" Style="{StaticResource MainMenuItemStyle}" Click="OnMenuConfiguracoesClick" />
            <MenuItem x:Name="MenuDados" Header="Dados" Style="{StaticResource MainMenuItemStyle}" Click="OnMenuDadosClick" />
            <MenuItem x:Name="MenuOfensores" Header="Ofensores" Style="{StaticResource MainMenuItemStyle}" Click="OnMenuOfensoresClick" />
            <MenuItem x:Name="MenuGraficos" Header="Gráficos" Style="{StaticResource MainMenuItemStyle}">
                <MenuItem x:Name="MenuGraficosDadosCorrentes" Header="Dados Correntes" Click="OnMenuGraficosDadosCorrentesClick" />
                <MenuItem x:Name="MenuGraficosTendencia" Header="Tendência" Click="OnMenuGraficosTendenciaClick" />
                <MenuItem x:Name="MenuGraficosEventos" Header="Eventos de Picos" Click="OnMenuGraficosEventosClick" />
            </MenuItem>
            <MenuItem x:Name="MenuRelatorios" Header="Relatórios" Style="{StaticResource MainMenuItemStyle}">
                <MenuItem x:Name="MenuRelatoriosGeral" Header="Geral" Click="OnMenuRelatoriosGeralClick" />
            </MenuItem>
            <MenuItem x:Name="MenuAjuda" Header="Ajuda" Style="{StaticResource MainMenuItemStyle}" Click="OnMenuAjudaClick" />
        </Menu>

        <Grid x:Name="ContentHost">

            <ScrollViewer x:Name="HomeTabRoot" Margin="16" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Visão geral" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Hardware.MachineName}" Foreground="Gray" FontSize="12" Margin="0,0,0,16" />

                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <Border BorderBrush="#E2E5EA" BorderThickness="1" CornerRadius="3" Background="#FAFBFC" Padding="16" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="RESUMO DO COMPUTADOR" FontSize="11" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome" Foreground="Gray" Margin="0,0,14,7" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hardware.MachineName}" FontWeight="Bold" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Sistema" Foreground="Gray" Margin="0,0,14,7" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hardware.OperatingSystem}" FontWeight="Bold" Margin="0,0,0,7" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Processador" Foreground="Gray" Margin="0,0,14,7" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Hardware.ProcessorName}" FontWeight="Bold" Margin="0,0,0,7" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Memória RAM" Foreground="Gray" Margin="0,0,14,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Hardware.RamTotalGb, StringFormat='{}{0:N1} GB'}" FontWeight="Bold" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Hardware.Disks}" Margin="0,7,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DriveName}" Foreground="Gray" Margin="0,0,14,0" />
                                                <TextBlock Grid.Column="1" FontWeight="Bold">
                                                    <Run Text="{Binding TotalGb, StringFormat='{}{0:N1} GB total', Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding FreeGb, StringFormat='{}{0:N1} GB livres', Mode=OneWay}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#E2E5EA" BorderThickness="1" CornerRadius="3" Background="#FAFBFC" Padding="16" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="RESUMO DE CONFIGURAÇÕES" FontSize="11" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,12" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" DataContext="{Binding MonitoringActive}">
                                    <TextBlock Text="Monitoramento" Width="200" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource ActivePillStyle}">
                                        <TextBlock Text="{Binding Converter={StaticResource BoolToActiveLabelConverter}}"
                                                   Foreground="{Binding Converter={StaticResource BoolToActiveForegroundConverter}}"
                                                   FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" DataContext="{Binding StartWithWindowsActive}">
                                    <TextBlock Text="Iniciar com o Windows" Width="200" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource ActivePillStyle}">
                                        <TextBlock Text="{Binding Converter={StaticResource BoolToActiveLabelConverter}}"
                                                   Foreground="{Binding Converter={StaticResource BoolToActiveForegroundConverter}}"
                                                   FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" DataContext="{Binding ExcludedProcessesActive}">
                                    <TextBlock Text="Processos excluídos" Width="200" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource ActivePillStyle}">
                                        <TextBlock Text="{Binding Converter={StaticResource BoolToActiveLabelConverter}}"
                                                   Foreground="{Binding Converter={StaticResource BoolToActiveForegroundConverter}}"
                                                   FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" DataContext="{Binding CustomDiskThresholdsActive}">
                                    <TextBlock Text="Limites de disco personalizados" Width="200" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource ActivePillStyle}">
                                        <TextBlock Text="{Binding Converter={StaticResource BoolToActiveLabelConverter}}"
                                                   Foreground="{Binding Converter={StaticResource BoolToActiveForegroundConverter}}"
                                                   FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Limites CPU / RAM / I/O" Width="200" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ThresholdsSummary}" Foreground="Gray" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Intervalo de amostragem" Width="200" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SampleIntervalSummary}" Foreground="Gray" VerticalAlignment="Center" />
                                </StackPanel>

                                <Border BorderBrush="#E2E5EA" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0" HorizontalAlignment="Stretch">
                                    <TextBlock HorizontalAlignment="Right">
                                        <Hyperlink Click="OnMenuConfiguracoesClick">Editar configurações →</Hyperlink>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border BorderBrush="#E2E5EA" BorderThickness="1" CornerRadius="3" Background="#FAFBFC" Padding="16">
                        <StackPanel>
                            <TextBlock Text="MONITOR DE RECURSOS EM TEMPO REAL" FontSize="11" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>

                                <wv2:WebView2 Grid.Column="0" x:Name="HomeLiveChartWebView" Height="220" />

                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Top 5 processos" FontWeight="Bold" Margin="0,0,0,6" />
                                    <TabControl>
                                        <TabItem Header="CPU">
                                            <ItemsControl ItemsSource="{Binding TopByCpu}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,0,0,2" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Converter={StaticResource GroupedProcessNameConverter}, Mode=OneWay}" />
                                                            <Run Text=" — " />
                                                            <Run Text="{Binding CpuPercent, StringFormat='{}{0:N1}%', Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </TabItem>
                                        <TabItem Header="RAM">
                                            <ItemsControl ItemsSource="{Binding TopByRam}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,0,0,2" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Converter={StaticResource GroupedProcessNameConverter}, Mode=OneWay}" />
                                                            <Run Text=" — " />
                                                            <Run Text="{Binding RamMb, StringFormat='{}{0:N0} MB', Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </TabItem>
                                        <TabItem Header="Disco I/O">
                                            <ItemsControl ItemsSource="{Binding TopByIo}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="0,0,0,2" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Converter={StaticResource GroupedProcessNameConverter}, Mode=OneWay}" />
                                                            <Run Text=" — " />
                                                            <Run Text="{Binding IoKbPerSec, StringFormat='{}{0:N0} KB/s', Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </TabItem>
                                    </TabControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock HorizontalAlignment="Right" Margin="0,16,0,0" Foreground="Gray" FontSize="11">
                        <Hyperlink NavigateUri="https://icons8.com" RequestNavigate="OnCreditHyperlinkRequestNavigate">Ícone por Icons8</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="MonitoringTabRoot" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="2" IsEnabled="{Binding CanEditSettings}">
                    <StackPanel Margin="0,0,16,8">
                        <Label Content="Intervalo de amostragem (s)" />
                        <TextBox Text="{Binding SampleIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <Label Content="Amostras seguidas p/ disparar alerta" />
                        <TextBox Text="{Binding ConsecutiveBreachesToAlert, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <Label Content="Amostras seguidas p/ recuperar" />
                        <TextBox Text="{Binding ConsecutiveRecoveriesToClear, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <Label Content="Top N processos no snapshot" />
                        <TextBox Text="{Binding TopProcessCount, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <Label Content="Segundos antes do pico (janela)" />
                        <TextBox Text="{Binding PreEventSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <Label Content="Segundos depois do pico (janela)" />
                        <TextBox Text="{Binding PostEventSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <Label Content="Limite CPU (%)" />
                        <TextBox Text="{Binding CpuPercent, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <Label Content="Limite RAM (%)" />
                        <TextBox Text="{Binding RamPercent, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,8">
                        <Label Content="Limite de I/O de disco (%)" />
                        <TextBox Text="{Binding DiskIoPercent, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </UniformGrid>

                <StackPanel Grid.Row="1" Margin="0,0,0,16" IsEnabled="{Binding CanEditSettings}">
                    <Label Content="Processos que não disparam os limites (aceita * como coringa, ex: notepad*)" Padding="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding ExcludedProcesses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Margin="0,0,8,8" Padding="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Content="Remover" Padding="4,0"
                                                Command="{Binding DataContext.RemoveExcludedProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox Text="{Binding NewExcludedProcessPattern, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0" />
                        <Button Content="Adicionar" Command="{Binding AddExcludedProcessCommand}" Padding="12,4" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,16" IsEnabled="{Binding CanEditSettings}">
                    <Label Content="Espaço livre mínimo por disco (%)" Padding="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding DiskThresholds}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Margin="0,0,8,8" Padding="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DriveName}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Text="{Binding MinFreePercent, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Salvar" Command="{Binding SaveCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Restaurar padrões" Command="{Binding RestoreDefaultsCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Iniciar" Command="{Binding StartCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Parar" Command="{Binding StopCommand}" Padding="12,4" Margin="0,0,16,0" />
                    <CheckBox Content="Iniciar com o Windows" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="4" VerticalAlignment="Top">
                    <TextBlock Text="{Binding StatusText}" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding LastSampleText}" />
                </StackPanel>

                <TextBlock Grid.Row="5" HorizontalAlignment="Right" Margin="0,16,0,0" Foreground="Gray" FontSize="11">
                    <Hyperlink NavigateUri="https://icons8.com" RequestNavigate="OnCreditHyperlinkRequestNavigate">Ícone por Icons8</Hyperlink>
                </TextBlock>
            </Grid>

            <Grid x:Name="DataTabRoot" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.4*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                    <TextBlock Text="Tendência diária" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="Exportar CSV" Command="{Binding ExportDailyTrendCsvCommand}" Padding="12,4" />
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding DailyTrend}"
                          AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Data" ToolTip="Dia (horário local) a que a média se refere" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding AvgCpuRawPercent, StringFormat='{}{0:N1}%'}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="CPU médio" ToolTip="Uso médio de CPU no dia (bruto, sem descontar processos excluídos)" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding AvgRamRawPercent, StringFormat='{}{0:N1}%'}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="RAM médio" ToolTip="Uso médio de RAM no dia (bruto, sem descontar processos excluídos)" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding AvgIoPercent, StringFormat='{}{0:N1}%'}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Disco I/O médio" ToolTip="Uso médio de I/O de disco no dia" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding AvgDiskFreePercent, Converter={StaticResource DiskUsageFromFreeConverter}}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Disco em uso" ToolTip="Percentual médio ocupado no disco do sistema (100% - espaço livre)" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding SystemDrive}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Unidade" ToolTip="Disco do sistema usado pra medir espaço livre/uso" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Base de picos" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Label Content="De:" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding FromDate}" Margin="4,0,12,0" />
                    <Label Content="Até:" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding ToDate}" Margin="4,0,12,0" />
                    <Button Content="Atualizar" Command="{Binding RefreshCommand}" Padding="12,4" />
                </StackPanel>

                <DataGrid Grid.Row="3" ItemsSource="{Binding Episodes}" SelectedItem="{Binding SelectedEpisode}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding StartEventId}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="ID" ToolTip="Identificador do evento de início (Start)" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Timestamp, Converter={StaticResource LocalDateTimeConverter}}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Data/Hora" ToolTip="Quando o alerta começou" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Converter={StaticResource DurationMinutesDisplayConverter}}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Duração" ToolTip="Tempo entre o início do alerta e a recuperação. 'Maior que' aparece quando o monitoramento foi parado antes do alerta recuperar." />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Metric, Converter={StaticResource MetricDisplayConverter}}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Métrica" ToolTip="Recurso que disparou o evento" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding DriveName}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Unidade" ToolTip="Unidade de disco afetada (quando aplicável)" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding RawValue, StringFormat='{}{0:N1}%'}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Valor bruto" ToolTip="Valor medido no momento do evento, sem descontar os processos excluídos" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding AdjustedValue, StringFormat='{}{0:N1}%'}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Valor líquido" ToolTip="Valor descontando os processos excluídos (só se aplica a CPU/RAM)" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Threshold, StringFormat='{}{0:N1}%'}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Limite" ToolTip="Limite configurado que foi violado" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Exportar CSV" Command="{Binding ExportCsvCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <Button Content="Ver gráfico" Command="{Binding ViewChartCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Row="5" BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Limpeza:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox Content="Cache (amostras em memória)" IsChecked="{Binding ClearCacheSelected}"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  ToolTip="Amostras ao vivo mantidas em memória enquanto o monitoramento roda — não tem arquivo em disco" />
                        <CheckBox Content="Tendência diária" IsChecked="{Binding ClearTrendSelected}"
                                  VerticalAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox Content="Base de picos" IsChecked="{Binding ClearPeaksSelected}"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  ToolTip="Eventos, amostras da janela de pico e snapshots de processos" />
                        <Button Content="Limpar selecionados" Command="{Binding ClearSelectedCommand}" Padding="12,4" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="OffendersTabRoot" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Aplicativos que mais estouram os limites" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Label Content="De:" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding PeriodFrom}" Margin="4,0,12,0" />
                    <Label Content="Até:" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding PeriodTo}" Margin="4,0,12,0" />
                    <Button Content="Atualizar" Command="{Binding RefreshCommand}" Padding="12,4" />
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Offenders}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding ProcessName}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Processo" ToolTip="Nome do processo" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Kind, Converter={StaticResource OffenderKindDisplayConverter}}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Métrica" ToolTip="Em qual métrica esse processo apareceu como consumidor de destaque" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding OccurrenceCount}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Ocorrências" ToolTip="Em quantos alertas distintos esse processo apareceu como consumidor de destaque" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding AvgValue, StringFormat='{}{0:N1}'}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Valor médio" ToolTip="Média de CPU (%), RAM (MB) ou I/O (KB/s), conforme a métrica" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding MaxValue, StringFormat='{}{0:N1}'}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Valor máximo" ToolTip="Maior valor registrado nesse período" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding LastSeenUtc, Converter={StaticResource LocalDateTimeConverter}}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Última ocorrência" ToolTip="Quando esse processo apareceu mais recentemente" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Exportar CSV" Command="{Binding ExportCsvCommand}" Padding="12,4" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ChartLiveTabRoot" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding LiveStatusText, StringFormat='Dados correntes (ao vivo): {0}'}" Margin="0,0,0,8" FontWeight="Bold" />
                <wv2:WebView2 Grid.Row="1" x:Name="LiveChartWebView" />
            </Grid>

            <Grid x:Name="ChartTrendTabRoot" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding TrendStatusText}" Margin="0,0,0,8" FontWeight="Bold" />
                <wv2:WebView2 Grid.Row="1" x:Name="TrendChartWebView" />
            </Grid>

            <Grid x:Name="ChartEventosTabRoot" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <Label Content="De:" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding PeriodFrom}" VerticalAlignment="Center" Margin="4,0,16,0" />
                    <Label Content="Até:" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding PeriodTo}" VerticalAlignment="Center" Margin="4,0,16,0" />
                    <CheckBox Content="CPU" IsChecked="{Binding IncludeCpu}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Content="RAM" IsChecked="{Binding IncludeRam}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Content="Disco I/O" IsChecked="{Binding IncludeDiscoIo}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="Carregar" Command="{Binding CarregarEventosDePicosCommand}" Padding="12,4" VerticalAlignment="Center" />
                </WrapPanel>

                <TextBlock Grid.Row="1" Text="{Binding EventosStatusText}" Margin="0,0,0,8" />

                <!-- Clicar num marcador (bolinha) abre EpisodeDetailWindow com os processos
                     daquele pico — ver chart.html (postMessage) + OnEventsChartWebMessageReceived. -->
                <wv2:WebView2 Grid.Row="2" x:Name="EventsChartWebView" />
            </Grid>

            <Grid x:Name="ReportTabRoot" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <Label Content="De:" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding PeriodFrom}" VerticalAlignment="Center" Margin="4,0,16,0" />
                    <Label Content="Até:" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding PeriodTo}" VerticalAlignment="Center" Margin="4,0,16,0" />
                    <CheckBox Content="CPU" IsChecked="{Binding IncludeCpu}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Content="RAM" IsChecked="{Binding IncludeRam}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Content="Disco I/O" IsChecked="{Binding IncludeDiscoIo}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <CheckBox Content="Incluir todos os eventos" IsChecked="{Binding IncludeAllEvents}" VerticalAlignment="Center" Margin="0,0,16,0"
                              ToolTip="Se desmarcado, o relatório mostra só o resumo e a quebra por métrica, sem a tabela completa de eventos" />
                    <Button Content="Gerar relatório" Command="{Binding GerarRelatorioCommand}" Padding="12,4" VerticalAlignment="Center" />
                </WrapPanel>

                <TextBlock Grid.Row="1" Text="{Binding StatusText}" Margin="0,0,0,8" />

                <wv2:WebView2 Grid.Row="2" x:Name="ReportWebView" />
            </Grid>

            <wv2:WebView2 x:Name="HelpWebView" Margin="16" Visibility="Collapsed" />

        </Grid>
    </DockPanel>
</Window>
