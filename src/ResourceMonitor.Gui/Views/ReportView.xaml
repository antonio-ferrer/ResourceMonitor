<UserControl x:Class="ResourceMonitor.Gui.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             >
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#E2E5EA" BorderThickness="1" CornerRadius="3" Background="#FAFBFC"
                Padding="12,10" Margin="0,4,0,12">
            <WrapPanel>
                <Label Content="De:" VerticalAlignment="Center" Margin="0,0,4,6" />
                <DatePicker SelectedDate="{Binding PeriodFrom}" VerticalAlignment="Center" Margin="0,0,22,6" />
                <Label Content="Até:" VerticalAlignment="Center" Margin="0,0,4,6" />
                <DatePicker SelectedDate="{Binding PeriodTo}" VerticalAlignment="Center" Margin="0,0,22,6" />
                <CheckBox Content="CPU" IsChecked="{Binding IncludeCpu}" VerticalAlignment="Center" Margin="0,0,16,6" />
                <CheckBox Content="RAM" IsChecked="{Binding IncludeRam}" VerticalAlignment="Center" Margin="0,0,16,6" />
                <CheckBox Content="Disco I/O" IsChecked="{Binding IncludeDiscoIo}" VerticalAlignment="Center" Margin="0,0,22,6" />
                <CheckBox Content="Ofensores" IsChecked="{Binding IncludeOffenders}" VerticalAlignment="Center" Margin="0,0,16,6" />
                <CheckBox Content="Padrão de horário" IsChecked="{Binding IncludeHourlyPattern}" VerticalAlignment="Center" Margin="0,0,16,6" />
                <CheckBox Content="Projeção de disco" IsChecked="{Binding IncludeDiskProjection}" VerticalAlignment="Center" Margin="0,0,22,6" />
                <CheckBox Content="Incluir todos os eventos" IsChecked="{Binding IncludeAllEvents}" VerticalAlignment="Center" Margin="0,0,0,6"
                          ToolTip="Se desmarcado, o relatório mostra só o resumo e a quebra por métrica, sem a tabela completa de eventos" />
            </WrapPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Margin="0,0,0,8" />

        <wv2:WebView2 Grid.Row="2" x:Name="ReportWebView" />
    </Grid>
</UserControl>
